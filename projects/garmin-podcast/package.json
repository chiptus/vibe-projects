{
  "name": "garmin-podcast",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "deployedSeparately": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "wrangler types && tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply garmin-podcast --local",
    "db:migrate:remote": "wrangler d1 migrations apply garmin-podcast --remote"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261108.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.82.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  }
}
